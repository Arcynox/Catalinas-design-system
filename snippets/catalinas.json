   "<div class=\"car-wrap\">",
   "<div class=\"car-head\">",
   "<b>Galeria",
   "</b>",
   "<span class=\"car-nav\">",
   "<button data-cat-car-prev aria-label=\"Anterior\">&#8249;",
   "</button>",
   "<button data-cat-car-next aria-label=\"Siguiente\">&#8250;",
   "</button>",
   "</span>",
   "</div>",
   "<div class=\"cat-carousel\">",
   "<div class=\"slide\">",
   "<b>Favoritos",
   "</b>",
   "<span>12 items",
   "</span>",
   "</div>",
   "<div class=\"slide\">",
   "<b>Recientes",
   "</b>",
   "<span>67 items",
   "</span>",
   "</div>",
   "<div class=\"slide\">",
   "<b>Compartidos",
   "</b>",
   "<span>8 items",
   "</span>",
   "</div>",
   "<div class=\"slide\">",
   "<b>Papelera",
   "</b>",
   "<span>3 items",
   "</span>",
   "</div>",
   "<div class=\"slide\">",
   "<b>Descargas",
   "</b>",
   "<span>21 items",
   "</span>",
   "</div>",
   "</div>",
   "</div>"
  ]
 },
 "cat-checkbox-radio": {
  "prefix": [
   "cat-checkbox-radio"
  ],
  "description": "Catalinas: Selección múltiple y exclusiva.",
  "body": [
   "<label class=\"cat-check\">",
   "<input type=\"checkbox\" checked>",
   "<span class=\"box\">",
   "</span>Checkbox",
   "</label>"
  ]
 },
 "cat-color-picker": {
  "prefix": [
   "cat-color-picker"
  ],
  "description": "Catalinas: Seleccion de accent para todo el sistema: swatches + auto (derivado del wallpaper).",
  "body": [
   "<div class=\"cat-colors\" data-cat-colors>",
   "<button class=\"cat-swatch auto active\" data-auto aria-label=\"Auto\">",
   "</button>",
   "<button class=\"cat-swatch\" style=\"background:#5e9eff\" data-color=\"#5e9eff\" aria-label=\"Azul\">",
   "</button>",
   "<button class=\"cat-swatch\" style=\"background:#a78bfa\" data-color=\"#a78bfa\" aria-label=\"Violeta\">",
   "</button>",
   "<button class=\"cat-swatch\" style=\"background:#f2a2c6\" data-color=\"#f2a2c6\" aria-label=\"Rosa\">",
   "</button>",
   "<button class=\"cat-swatch\" style=\"background:#ef5a76\" data-color=\"#ef5a76\" aria-label=\"Rojo\">",
   "</button>",
   "<button class=\"cat-swatch\" style=\"background:#34c759\" data-color=\"#34c759\" aria-label=\"Verde\">",
   "</button>",
   "<span class=\"cat-label-side\">cambia todo el UI",
   "</span>",
   "</div>"
  ]
 },
 "cat-command-palette": {
  "prefix": [
   "cat-command-palette"
  ],
  "description": "Catalinas: Palette de comandos global (Ctrl+K / Cmd+K). Busca, navega con flechas, ejecuta con Enter.",
  "body": [
   "<div class=\"cat-cmdk-overlay open\">",
   "<div class=\"cat-cmdk\" role=\"dialog\" aria-modal=\"true\">",
   "<input class=\"cmdk-input\" placeholder=\"Escribe un comando...\">",
   "<div class=\"cmdk-list\">",
   "<button class=\"cat-menu-item cmdk-item is-active\" role=\"option\">Nuevo archivo",
   "<span class=\"menu-kbd\">N",
   "</span>",
   "</button>",
   "<button class=\"cat-menu-item cmdk-item\" role=\"option\">Abrir reciente",
   "<span class=\"menu-kbd\">Ctrl+O",
   "</span>",
   "</button>",
   "</div>",
   "<div class=\"cmdk-foot\">",
   "<span class=\"menu-kbd\">ESC cerrar",
   "</span>",
   "</div>",
   "</div>",
   "</div>"
  ]
 },
 "cat-dialog": {
  "prefix": [
   "cat-dialog"
  ],
  "description": "Catalinas: Modal nativo <dialog> con backdrop blur. Foco y ESC gratis.",
  "body": [
   "<dialog class=\"cat-dialog\">",
   "<h3>Titulo",
   "</h3>",
   "<p>Contenido",
   "</p>",
   "<form method=\"dialog\">",
   "<button class=\"cat-btn primary\">OK",
   "</button>",
   "</form>",
   "</dialog>"
  ]
 },
 "cat-dropzone": {
  "prefix": [
   "cat-dropzone"
  ],
  "description": "Catalinas: Zona de carga drag and drop. Visual puro; estado :drag-over via clase .over (JS del host).",
  "body": [
   "<label class=\"cat-dropzone\">",
   "<input type=\"file\" multiple hidden>",
   "<b>Solta archivos aca",
   "</b>",
   "<span>o hace clic para elegir",
   "</span>",
   "</label>"
  ]
 },
 "cat-empty-state": {
  "prefix": [
   "cat-empty-state"
  ],
  "description": "Catalinas: Estado vacio: orbe con icono, titulo, descripcion y accion primaria.",
  "body": [
   "<div class=\"cat-empty\">",
   "<div class=\"cat-empty-orb\">",
   "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">",
   "<path d=\"M13 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9z\"/>",
   "<path d=\"M13 3v6h6\"/>",
   "<path d=\"M12 12v6m-3-3h6\"/>",
   "</svg>",
   "</div>",
   "<h4 class=\"cat-empty-title\">Sin resultados",
   "</h4>",
   "<p class=\"cat-empty-msg\">Proba con otros terminos o crea algo nuevo.",
   "</p>",
   "<button class=\"cat-btn primary sm\">Crear",
   "</button>",
   "</div>"
  ]
 },
 "cat-file-chip": {
  "prefix": [
   "cat-file-chip"
  ],
  "description": "Catalinas: Chip de archivo adjunto/subido: icono, nombre, peso, remover.",
  "body": [
   "<span class=\"cat-filechip\">",
   "<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#5f8af5\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">",
   "<path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z\"/>",
   "<path d=\"M14 3v5h5\"/>",
   "</svg>",
   "<span class=\"fc-name\">informe.pdf",
   "</span>",
   "<span class=\"fc-size\">2.4 MB",
   "</span>",
   "<button class=\"fc-x\" aria-label=\"Quitar\">x",
   "</button>",
   "</span>"
  ]
 },
 "cat-filter-chips": {
  "prefix": [
   "cat-filter-chips"
  ],
  "description": "Catalinas: Chips de filtro multi-seleccion con estado activo accent.",
  "body": [
   "<div class=\"cat-chips\">",
   "<label class=\"chip active\">Documentos",
   "<input type=\"checkbox\" checked hidden>",
   "</label>",
   "<label class=\"chip\">Presentaciones",
   "<input type=\"checkbox\" hidden>",
   "</label>",
   "<label class=\"chip\">Carpetas",
   "<input type=\"checkbox\" hidden>",
   "</label>",
   "</div>"
  ]
 },
 "cat-form-validation": {
  "prefix": [
   "cat-form-validation"
  ],
  "description": "Catalinas: Validacion declarativa: required/email/minLength via atributos. Errores inline y evento cat:valid.",
  "body": [
   "<form class=\"cat-form\" data-cat-validate novalidate>",
   "<div class=\"cat-field\">",
   "<label class=\"cat-label\">Email *",
   "</label>",
   "<div class=\"cat-input has-icon\">",
   "<input class=\"el\" required data-cat-type=\"email\" placeholder=\"tu@email.com\">",
   "</div>",
   "</div>",
   "</form>"
  ]
 },
 "cat-icons": {
  "prefix": [
   "cat-icons"
  ],
  "description": "Catalinas: Iconos themable con runtime CatalinasIcons. Default: Lucide (SVG). Alternativas por CDN webfont.",
  "body": [
   "<span data-cat-icon=\"folder\">",
   "</span>"
  ]
 },
 "cat-input": {
  "prefix": [
   "cat-input"
  ],
  "description": "Catalinas: Campo de texto, con icono opcional y estado de error.",
  "body": [
   "<div class=\"cat-field\">",
   "<label class=\"cat-label\">Name",
   "</label>",
   "<div class=\"cat-input\">",
   "<input class=\"el\" placeholder=\"Placeholder\">",
   "</div>",
   "</div>"
  ]
 },
