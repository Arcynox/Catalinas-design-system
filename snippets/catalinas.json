 },
 "cat-menu": {
  "prefix": [
   "cat-menu"
  ],
  "description": "Catalinas: Dropdown flotante nivel depth.dropdown. Trigger por data-attr.",
  "body": [
   "<div data-cat-menu>",
   "<button class=\"cat-btn secondary\" data-cat-menu-trigger aria-expanded=\"false\">Options ▾",
   "</button>",
   "<div class=\"cat-menu\" role=\"menu\">",
   "<button class=\"cat-menu-item checked\" role=\"menuitem\">Details",
   "<span class=\"mi-check\">",
   "<svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">",
