{
 "cat-accordion": {
  "prefix": [
   "cat-accordion"
  ],
  "description": "Catalinas: Colapsable nativo <details>, sin JS.",
  "body": [
   "<details class=\"cat-accordion\">",
   "<summary>Titulo",
   "<svg class=\"chev\" width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\">",
   "<path d=\"M6 9l6 6 6-6\"/>",
   "</svg>",
   "</summary>",
   "<div class=\"body\">Contenido",
   "</div>",
   "</details>"
  ]
 },
 "cat-alert-banner": {
  "prefix": [
   "cat-alert-banner"
  ],
  "description": "Catalinas: Banner de estado con icono lider y tinte de fondo por severidad. Sin franjas laterales ni bordes semanticos.",
  "body": [
   "<div class=\"cat-alert\">",
   "<span class=\"a-icon\">",
   "<svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\">",
   "<circle cx=\"12\" cy=\"12\" r=\"9\"/>",
   "<path d=\"M12 8h.01M12 11v5\"/>",
   "</svg>",
   "</span>",
   "<div class=\"a-body\">",
   "<b>Title",
   "</b>",
   "<span>Message",
   "</span>",
   "</div>",
   "<button class=\"t-close\" data-cat-dismiss=\".cat-alert\">x",
   "</button>",
   "</div>"
  ]
 },
 "cat-app-header": {
  "prefix": [
   "cat-app-header"
  ],
  "description": "Catalinas: Barra superior de aplicacion: marca, navegacion y acciones.",
  "body": [
   "<header class=\"cat-appheader\">",
   "<span class=\"brand\">App",
   "</span>",
   "<nav>",
   "<a class=\"is-active\">Inicio",
   "</a>",
   "<a>Datos",
   "</a>",
   "<a>Ajustes",
   "</a>",
   "</nav>",
   "<span class=\"spacer\">",
   "</span>",
   "<button class=\"cat-btn primary sm\">Nuevo",
   "</button>",
   "</header>"
  ]
 },
 "cat-app-shell": {
  "prefix": [
   "cat-app-shell"
  ],
  "description": "Catalinas: Layout de aplicacion completa: chrome + toolbar + sidebar + contenido + statusbar. Grid unico.",
  "body": [
   "<div class=\"cat-appshell\">",
   "<header class=\"cat-shell-chrome\">",
   "</header>",
   "<div class=\"cat-shell-toolbar\">",
   "</div>",
   "<div class=\"cat-shell-body\">",
   "<aside class=\"cat-sidebar\">",
   "</aside>",
   "<main class=\"cat-shell-main\">",
   "</main>",
   "</div>",
   "<footer class=\"cat-statusbar\">",
   "</footer>",
   "</div>"
  ]
 },
 "cat-avatar-group": {
  "prefix": [
   "cat-avatar-group"
  ],
  "description": "Catalinas: Stack de avatares con overlap y contador restante.",
  "body": [
   "<div class=\"cat-avgroup\">",
   "<span class=\"cat-avatar\">LU",
   "</span>",
   "<span class=\"cat-avatar\">MI",
   "</span>",
   "<span class=\"cat-avatar\">CO",
   "</span>",
   "<span class=\"cat-avatar more\">+5",
   "</span>",
   "</div>"
  ]
 },
 "cat-badge-tooltip-kbd-avatar": {
  "prefix": [
   "cat-badge-tooltip-kbd-avatar"
  ],
  "description": "Catalinas: Micro-componentes: badge, tooltip CSS-only, tecla, divisor y avatar.",
  "body": [
   "<span class=\"cat-badge accent\">New",
   "</span>"
  ]
 },
 "cat-breadcrumb-toolbar": {
  "prefix": [
   "cat-breadcrumb-toolbar"
  ],
  "description": "Catalinas: Ruta jerárquica + banda de acciones con gradiente de identidad.",
  "body": [
   "<nav class=\"cat-breadcrumb\">",
   "<span class=\"crumb\">This PC",
   "</span>",
   "<span class=\"sep\">›",
   "</span>",
   "<span class=\"crumb current\">Documents",
   "</span>",
   "</nav>"
  ]
 },
 "cat-button": {
  "prefix": [
   "cat-button"
  ],
  "description": "Catalinas: Acción primaria, secundaria, fantasma, peligrosa o enlace.",
  "body": [
   "<button class=\"cat-btn primary\">Primary",
   "</button>"
  ]
 },
 "cat-card-toast": {
  "prefix": [
   "cat-card-toast"
  ],
  "description": "Catalinas: Superficies por nivel de profundidad + notificaciones descartables.",
  "body": [
   "<div class=\"cat-card\">Card L2 (contenido)",
   "</div>"
  ]
 },
 "cat-carousel": {
  "prefix": [
   "cat-carousel"
  ],
  "description": "Catalinas: Carrusel horizontal con scroll-snap y flechas prev/next.",
