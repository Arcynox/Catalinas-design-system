   "<span class=\"menu-kbd\">F2",
   "</span>",
   "</button>",
   "</div>",
   "</div>"
  ]
 },
 "cat-meter": {
  "prefix": [
   "cat-meter"
  ],
  "description": "Catalinas: Medidor semantico (disco, RAM): verde/amarillo/rojo segun umbral.",
  "body": [
