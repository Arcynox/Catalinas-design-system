   "css": [
    "\n.cat-rating{display:inline-flex;gap:3px}\n.star{width:21px;height:21px;padding:0;border:none;background:none;color:var(--cat-color-stroke-input);cursor:pointer;transition:transform 120ms var(--cat-motion-ease-out),color 120ms ease}\n.star:hover{transform:scale(1.18)}\n.star.on{color:var(--cat-color-warning)}\n.star svg{width:100%;height:100%;display:block}"
   ]
  },
  "qt": {
   "widget": "(custom)",
   "qss": [
    "QLabel[cat=\"stars\"]{color:{$color.warning$};font-size:18px;letter-spacing:2px}"
   ]
  }
 },
